# Orange Pi 5 Max LLM Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=opi5-max-llm-setup
APP_VERSION=0.1.0

# =============================================================================
# Logging Settings
# =============================================================================
LOGGING_LEVEL=INFO

# =============================================================================
# API Settings
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# Ollama Settings
# =============================================================================
# Ollama server URL (change if running on different host)
OLLAMA_BASE_URL=http://localhost:11434

# Default model for inference
# Recommended models for 16GB Orange Pi 5 Max:
#   - qwen2.5:3b (fast, efficient)
#   - phi3:mini (good for coding)
#   - gemma2:2b (very fast)
#   - llama3.2:3b (good all-rounder)
#   - mistral:7b-instruct-q4_0 (high quality, uses more RAM)
OLLAMA_MODEL=qwen2.5:3b

# Memory management (keep these at 1 for 16GB RAM)
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# =============================================================================
# Embedding Settings
# =============================================================================
# Embedding model for RAG (runs locally on CPU)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Device for embedding model (cpu recommended for ARM64)
EMBEDDING_DEVICE=cpu

# =============================================================================
# Vector Database Settings (ChromaDB)
# =============================================================================
# Directory for ChromaDB persistence
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Collection name for documents
CHROMA_COLLECTION_NAME=documents

# =============================================================================
# RAG Settings
# =============================================================================
# Text chunk size for document splitting
CHUNK_SIZE=500

# Overlap between chunks (helps with context continuity)
CHUNK_OVERLAP=50

# Number of documents to retrieve for RAG queries
RETRIEVAL_K=3

# =============================================================================
# Document Upload Settings
# =============================================================================
# Directory for uploaded documents
UPLOAD_DIRECTORY=./data/uploads

# Maximum upload file size in MB
MAX_UPLOAD_SIZE_MB=50
